import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import joblib

from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.svm import SVR
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import mean_absolute_error,r2_score

#LOAD DATA
from ucimlrepo import fetch_ucirepo
dataset=fetch_ucirepo(id=235)
df=dataset.data.original

text_columns=["Date","Time"]


for col in df.columns:
    if col not in text_columns:
        df[col]=pd.to_numeric(df[col],errors="coerce" )

df['datetime'] = pd.to_datetime(df["Date"] + ' ' + df["Time"], format="%d/%m/%Y %H:%M:%S")


print(df.head())
print(df.info())

#Data Cleaning & Preprocessing
print("\n cleaning data")

df=df.dropna()

daily_df=(
          df
          . set_index("datetime")
          . resample("D")
          . mean()
)

print(daily_df.head())

#Feature Engineering 
print("\nFeature Engineering ") 

daily_df["lag_1"] =daily_df["Global_active_power"].shift(1)
daily_df=daily_df.dropna()
X=daily_df[["lag_1"]]
Y=daily_df["Global_active_power"]

#Train-Test-Split
split_index=int(len(daily_df)*0.8)
X_train=X.iloc[:split_index] 
X_test=X.iloc[split_index:]
Y_train=Y.iloc[:split_index] 
Y_test=Y.iloc[split_index:]
print(f"Train size: {len(X_train)}, Test size: {len(X_test)}")

#Feature_Scaling,it's important for SVM
scaler=StandardScaler()
X_train_scaled=scaler.fit_transform(X_train) 
X_test_scaled=scaler.transform(X_test) 

print("\nTraining models") 
Ir=LinearRegression() 
Ir.fit(X_train,Y_train )

svr=SVR(kernel="rbf")
svr.fit(X_train_scaled,Y_train )

#saveing the model 
joblib.dump(Ir,"linear_regression.pkl") 
joblib.dump(svr,"SVR_model.pkl") 
joblib.dump(scaler,"scaler.pkl") 
print("Models saved successfully ")

#Prediction
Ir_pred=Ir.predict(X_test) 
svr_pred=svr.predict(X_test_scaled)

def evaluate_model(name, y_true, y_pred):
    print(f"\n{name}")
    print("MAE:", mean_absolute_error(y_true, y_pred))
    print("R² :", r2_score(y_true, y_pred))


evaluate_model("Linear Regression", Y_test, Ir_pred)
evaluate_model("SVR", Y_test, svr_pred)
